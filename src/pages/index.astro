---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-8 pb-6">
      <div class="mt-4 mb-2 flex items-center gap-3 sm:mt-8 sm:mb-3">
        <h1 class="inline-block text-4xl font-bold sm:text-5xl">
          ਸਤਿ ਸ੍ਰੀ ਅਕਾਲ
        </h1>
        <a
          target="_blank"
          href="./rss.xml"
          class="inline-block"
          aria-label="rss feed"
          title="RSS Feed"
        >
          <IconRss
            width={20}
            height={20}
            class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>

      <!-- Definition Toggle Button -->
      <div class="mb-4">
        <button
          id="greeting-toggle"
          class="flex items-center gap-1 text-xs text-gray-600 transition-colors duration-200 hover:text-accent dark:text-gray-400"
          aria-expanded="false"
          aria-controls="greeting-definition"
        >
          <span>What does this mean?</span>
          <span id="toggle-arrow" class="transition-transform duration-200"
            >▼</span
          >
        </button>

        <!-- Expandable Definition -->
        <div
          id="greeting-definition"
          class="mt-2 hidden rounded-lg border border-gray-200 bg-gray-50 p-3 text-sm dark:border-gray-700 dark:bg-gray-800"
        >
          <div class="space-y-2">
            <div>
              <span class="font-semibold text-gray-900 dark:text-gray-100"
                >Sat Sri Akal</span
              >
              <span class="ml-2 text-gray-600 dark:text-gray-400"
                >pronounced [sət sɾiː əkɑːl]</span
              >
            </div>
            <div class="text-gray-700 dark:text-gray-300">
              <div>
                Traditional Sikh greeting that means "Truth is the Timeless
                One".
              </div>
            </div>
          </div>
        </div>
      </div>

      <p>
        I am Ramneet, a Research Fellow at
        <LinkButton
          class="underline decoration-dashed underline-offset-4 hover:text-accent"
          href="https://www.microsoft.com/en-us/research/lab/microsoft-research-india/"
        >
          Microsoft Research India
        </LinkButton>. I love learning about programming languages theory,
        compiler design, and machine learning. I also love sports, music and
        food. This is my personal corner of the internet where I write about all
        these (and more). Enjoy :)
      </p>
      <p class="mt-2">
        You can visit
        <LinkButton
          class="underline decoration-dashed underline-offset-4 hover:text-accent"
          href="https://ramneet-singh.netlify.app/"
        >
          my personal website
        </LinkButton> to know more about my work and projects.
      </p>
      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex flex-col sm:flex-row sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
            <ul>
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="./posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }

    // Greeting definition toggle functionality
    const toggleButton = document.getElementById("greeting-toggle");
    const definition = document.getElementById("greeting-definition");
    const arrow = document.getElementById("toggle-arrow");

    if (toggleButton && definition && arrow) {
      toggleButton.addEventListener("click", () => {
        const isHidden = definition.classList.contains("hidden");

        if (isHidden) {
          // Show definition
          definition.classList.remove("hidden");
          arrow.style.transform = "rotate(180deg)";
          toggleButton.setAttribute("aria-expanded", "true");
        } else {
          // Hide definition
          definition.classList.add("hidden");
          arrow.style.transform = "rotate(0deg)";
          toggleButton.setAttribute("aria-expanded", "false");
        }
      });
    }
  });
</script>
